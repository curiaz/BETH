# ============================================================
# BETHBot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development
TRADING_MODE=paper

# --- Exchange ---
EXCHANGE=binance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Trading ---
PAPER_INITIAL_BALANCE=10000
SUPPORTED_SYMBOLS=BTC/USDT,ETH/USDT
DEFAULT_TIMEFRAME=1h

# --- Database ---
# SQLite (development — no setup required):
DATABASE_URL=sqlite+aiosqlite:///./bethbot.db

# PostgreSQL (production / Docker):
# DATABASE_URL=postgresql+asyncpg://bethbot:bethbot_dev@localhost:5432/bethbot

# --- Notifications ---
DISCORD_WEBHOOK_URL=

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO
